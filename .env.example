# =========================================================================
# RelAte Environment Configuration Template
# Copy this file to .env and fill in your keys
# =========================================================================

# Active LLM Provider: 'gemini' (Dev Free Tier) or 'azure_openai' (Prod)
LLM_PROVIDER=gemini

# Google Gemini API (Dev/Validation)
GEMINI_API_KEY=your_gemini_api_key_here

# Azure OpenAI (Production Cutover)
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure SQL Connection String
AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-server.database.windows.net,1433;Database=relate_db;Uid=your_username;Pwd=your_password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;
